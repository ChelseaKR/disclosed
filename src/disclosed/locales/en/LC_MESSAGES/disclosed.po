# The site's user-facing prose, in the language it is written and reviewed in.
#
# This is the source catalog: every other locale is checked against it, key for key and
# placeholder for placeholder, and one that does not match is refused rather than part-rendered.
# See src/disclosed/messages.py for the rules and docs/I18N.md for what is still unfinished.
#
# Two things are deliberately NOT here.
#
# The five classification tokens -- reported, implausible, suppressed, not_applicable, missing --
# appear below only as the keys classification.<token>.label and .meaning. The tokens themselves
# are data: they are what the grader writes, what the report carries, and what the CSV export and
# its Table Schema publish, and they stay in that one form in every language. Translating them in
# the export would give every downstream reader a file that no longer joins.
#
# Field labels, rationales and statute names are not here either. They come from
# src/disclosed/fields.py and from the artifacts, because they are the wording the grader applies
# and the wording the schema publishes; a rationale that read one way on the page and another in
# the schema would be two different rules.
#
msgid ""
msgstr ""
"Project-Id-Version: disclosed\n"
"Language: en\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"
"X-OG-Locale: en_US\n"

#. The five classifications, as a reader meets them. The label is what the badge says; the
#. meaning is written for a person who has just been told their college scored badly.
msgid "classification.reported.label"
msgstr "Reported"

msgid "classification.reported.meaning"
msgstr "A credible value was published."

msgid "classification.implausible.label"
msgstr "Implausible"

msgid "classification.implausible.meaning"
msgstr ""
"A value was published but falls outside the credible range for this field. Counted as a "
"disclosure failure: a gap is visible to a reader, a wrong number is not."

msgid "classification.suppressed.label"
msgstr "Suppressed"

msgid "classification.suppressed.meaning"
msgstr ""
"Withheld deliberately, usually to protect a small cohort. Not held against the institution "
"and removed from the denominator entirely."

msgid "classification.not_applicable.label"
